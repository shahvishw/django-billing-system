# Django
# Use a long, random value in production. Do not commit your real .env file.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Kolkata
# If deployed behind a trusted proxy, configure it to replace this header with
# the real client IP before setting LOGIN_RATE_LIMIT_IP_HEADER to that header.
# LOGIN_RATE_LIMIT_IP_HEADER=REMOTE_ADDR

# Production HTTPS and browser protections. HTTPS options default on when DEBUG=False.
# Set SECURE_SSL_REDIRECT=False only for local or non-HTTPS staging environments.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True only when every subdomain uses HTTPS.
# SECURE_HSTS_PRELOAD=True only after confirming the domain can meet preload requirements.
# USE_X_FORWARDED_PROTO=True only behind a trusted proxy that sets this header itself.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# Database
# Leave DB_NAME unset to use SQLite locally (db.sqlite3).
# Set all values below to use PostgreSQL.
# DB_NAME=invoicepro
# DB_USER=invoicepro
# DB_PASSWORD=replace-this-password
# DB_HOST=localhost
# DB_PORT=5432

# Email
# Development email is printed to the terminal by default.
# To send SMTP email, uncomment and provide the values below.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-email@example.com
# With DEBUG=False and no SMTP credentials, outbound email is disabled rather than logged.
